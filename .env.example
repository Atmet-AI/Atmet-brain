# Reference only. The core does not load this file automatically.
ATMET_HOME=/private/path/to/brain-data
ATMET_TOKEN_FILE=/private/path/to/scoped-worker.token
# Keep the recovery journal in an independently recoverable private location.
ATMET_RECOVERY_JOURNAL=/independent/private/storage/recovery-journal.json
ATMET_EXTRACTOR=local
# Optional compatible model settings. Enable remote processing in private config first.
# ATMET_MODEL_BASE_URL=https://your-provider.example/v1
# ATMET_MODEL=your-selected-model
# ATMET_MODEL_API_KEY=replace-privately
# ATMET_GMAIL_TOKEN=replace-privately
